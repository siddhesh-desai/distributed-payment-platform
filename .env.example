# Local development defaults.
# Copy to `.env` (gitignored). Compose loads that file via `env_file`.
# You MUST add POSTGRES_PASSWORD in `.env` (never commit `.env`).

# Postgres
POSTGRES_USER=payflow
POSTGRES_DB=payflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_TIMEOUT_SECONDS=30
